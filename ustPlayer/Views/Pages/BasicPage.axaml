<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UstPlayer.ViewModels"
             xmlns:controls="using:UstPlayer.Views.Controls"
             x:Class="UstPlayer.Views.Pages.BasicPage"
             x:DataType="vm:BasicPageViewModel">

  <!--
    基础页（对应 1.1.x basic_page.py）：项目信息 + 显示选项 + 播放。
    版式对齐 Windows 11 设置应用：分组标题在卡片之外，每行「左标题 / 右控件」。

    所有输入控件**直接双向绑定设置子域**——导入工程改了设置，界面自动跟着变，
    不需要 1.1.x 的 sync_all_from_settings()。
    文本一律在 code-behind 用 Translator.Tr(...) 赋值（见 AGENTS.md 的 i18n 约定）。
  -->
  <ScrollViewer>
    <StackPanel Margin="24,4,24,24">

      <!-- ===================== 项目 ===================== -->
      <controls:SettingsSection x:Name="ProjectSection">
        <StackPanel>
          <controls:SettingsRow x:Name="ProjectNameRow">
            <TextBox x:Name="ProjectNameBox" MinWidth="320"
                     Text="{Binding Project.ProjectName, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="SongNameRow">
            <TextBox x:Name="SongNameBox" MinWidth="320"
                     Text="{Binding Project.SongName, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="SongAuthorRow">
            <TextBox x:Name="SongAuthorBox" MinWidth="320"
                     Text="{Binding Project.SongAuthor, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="UstAuthorRow">
            <TextBox x:Name="UstAuthorBox" MinWidth="320"
                     Text="{Binding Project.UstAuthor, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="MusicRow">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="MusicPathBox" MinWidth="320"
                       Text="{Binding Project.MusicPath, Mode=TwoWay}" />
              <Button x:Name="MusicButton" Click="OnSelectMusicClick" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ProjectFileRow">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="ImportButton" Click="OnImportClick" />
              <Button x:Name="ExportButton" Click="OnExportClick" />
            </StackPanel>
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsSection>

      <!-- ===================== 显示选项 ===================== -->
      <controls:SettingsSection x:Name="DisplaySection">
        <StackPanel>
          <controls:SettingsRow x:Name="ShowBpmRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowBpm, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ShowPlayTimeRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowPlayTime, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ShowSongNameRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowSongName, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ShowSongAuthorRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowSongAuthor, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ShowUstAuthorRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowUstAuthor, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ShowNoteNameRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowNoteName, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ShowUstLyricRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowUstLyric, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="ShowCopyrightRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowCopyright, Mode=TwoWay}" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsSection>

      <!-- ===================== 播放（1.1.x 同样把播放按钮放在卡片之外） ===================== -->
      <Button x:Name="PlayButton" HorizontalAlignment="Stretch"
              MinHeight="40" Margin="0,18,0,0"
              Click="OnPlayClick"
              Classes="accent" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
