<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls">

  <!--
    跨控件的样式（ControlTheme 放不下的部分：目标不是本仓库定义的控件）。
  -->

  <!--
    开关不带「开 / 关」文字：设置行里的开关就是裸控件，行标题已经说明这一项是什么；
    FluentAvalonia 的 ToggleSwitch 默认会显示 On/Off。
  -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
  </Style>

  <!--
    卡片外观：给不是「一行」的内容用（例如文件页的预览区整块内容）。
    与 SettingsRow 的卡片保持一致，避免页面里各写一遍颜色与圆角。
  -->
  <Style Selector="Border.settingsCard">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <!--
    分组标题（卡片之外的那行字）：比正文略重一点，与下方卡片拉开距离。
  -->
  <Style Selector="TextBlock.settingsSectionHeader">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="2,18,0,8" />
  </Style>

  <!--
    设置页的行用的是 FluentAvalonia 自带的 SettingsExpander，其他四页用的是本仓库的
    SettingsRow，两者默认外边距不同——设置页的卡片因此比别页贴得更紧，看起来像另一套版式。
    这里把 SettingsExpander 的间距对齐 SettingsRow 的 `0,0,0,4`，五个页面的卡片间距就一致了。
  -->
  <Style Selector="fa|SettingsExpander">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <!--
    ===================== 页面进入动画（卡片错峰上浮淡入）=====================

    做法与参数对齐 ClassIsland 的 StackPanelIntroAnimationBehavior（其 animated-intro 样式）：
    子元素先置为「透明 + 下移 50px」，随后由 code-behind 按 25ms 节奏逐个加上
    intro-play 类，样式里的动画在 0.6 秒内把它带回原位并淡入。

    为什么用两个类而不是直接改属性：
    · intro-armed 加在页面根上，表示「本页的子元素尚未入场」——它必须与
      intro-play 分开，否则动画一加类就立刻重放，错峰效果会消失；
    · 播放结束由 code-behind 撤掉 intro-armed，样式中的 Animation 以
      FillMode=Both 保持终止值，无需逐元素清理。

    缓动 (0.00, 1.00, 0.00, 1.00) 与 ClassIsland 一致：起步极快、末段极缓，
    观感是「轻盈地浮上来」而不是匀速平移。
  -->
  <Style Selector="Panel.intro-armed > :is(Control):not(.intro-play)">
    <Setter Property="Opacity" Value="0" />
    <Setter Property="RenderTransform">
      <Setter.Value>
        <TranslateTransform Y="50" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="Panel.intro-armed > :is(Control).intro-play">
    <Style.Animations>
      <Animation Duration="0:0:0.6" FillMode="Both" Easing="0.00, 1.00, 0.00, 1.00">
        <KeyFrame Cue="0%">
          <Setter Property="TranslateTransform.Y" Value="50" />
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="TranslateTransform.Y" Value="0" />
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

</Styles>
