<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UstPlayer.ViewModels"
             xmlns:controls="using:UstPlayer.Views.Controls"
             xmlns:conv="using:UstPlayer.Views.Converters"
             x:Class="UstPlayer.Views.Pages.PlayerStylePage"
             x:DataType="vm:PlayerStylePageViewModel">

  <!--
    播放器样式页（对应 1.1.x player_style_page.py）：颜色、歌词位置、字体与其他显示设置。
    版式对齐 Windows 11 设置应用：分组标题在卡片外，每行「左标题 / 右控件」。

    · 颜色与自定义文字**直接双向绑定设置子域**（{Binding Color.BackgroundColor, Mode=TwoWay}）：
      设置子域自身会通知变更，导入工程后界面自动刷新，不需要 1.1.x 的 sync_all_from_settings()。
    · 颜色输入框用 UpdateSourceTrigger=LostFocus：中途输入（如「#12」）本身非法，
      若每敲一个键就写回设置，设置层会判定非法并回退默认值，把用户正在输入的内容冲掉。
    · 下拉框的候选项是「稳定 key + 译文」的对象（vm:ChoiceOption），key 才是写回存储层的值。
    · 文本一律在 code-behind 用 Translator.Tr(...) 赋值（见 AGENTS.md 的 i18n 约定）。
  -->
  <UserControl.Resources>
    <conv:HexToColorConverter x:Key="HexColorConverter" />
    <conv:HexToBrushConverter x:Key="HexBrushConverter" />

    <!-- 下拉项模板：显示译文，选中后把 key 写回设置（由 ChoiceGroup 完成） -->
    <DataTemplate x:Key="ChoiceTemplate" x:DataType="vm:ChoiceOption">
      <TextBlock Text="{Binding Text}" />
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="24,4,24,24">

      <!-- ===================== 播放器样式 ===================== -->
      <controls:SettingsSection x:Name="StyleSection">
        <StackPanel>
          <controls:SettingsRow x:Name="BackgroundColorRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBox x:Name="BackgroundColorBox" Width="110"
                       Text="{Binding Color.BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Border Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                      Background="{Binding Color.BackgroundColor, Converter={StaticResource HexBrushConverter}}" />
              <ColorPicker x:Name="BackgroundColorPicker"
                           IsAlphaEnabled="False" IsAlphaVisible="False"
                           Color="{Binding Color.BackgroundColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="NoteColorRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBox x:Name="NoteColorBox" Width="110"
                       Text="{Binding Color.NoteColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Border Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                      Background="{Binding Color.NoteColor, Converter={StaticResource HexBrushConverter}}" />
              <ColorPicker x:Name="NoteColorPicker"
                           IsAlphaEnabled="False" IsAlphaVisible="False"
                           Color="{Binding Color.NoteColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="LyricColorRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBox x:Name="LyricColorBox" Width="110"
                       Text="{Binding Color.LyricColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Border Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                      Background="{Binding Color.LyricColor, Converter={StaticResource HexBrushConverter}}" />
              <ColorPicker x:Name="LyricColorPicker"
                           IsAlphaEnabled="False" IsAlphaVisible="False"
                           Color="{Binding Color.LyricColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="LyricTextColorRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBox x:Name="LyricTextColorBox" Width="110"
                       Text="{Binding Color.LyricTextColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Border Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                      Background="{Binding Color.LyricTextColor, Converter={StaticResource HexBrushConverter}}" />
              <ColorPicker x:Name="LyricTextColorPicker"
                           IsAlphaEnabled="False" IsAlphaVisible="False"
                           Color="{Binding Color.LyricTextColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="PitchCurveColorRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBox x:Name="PitchCurveColorBox" Width="110"
                       Text="{Binding Color.PitchCurveColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Border Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                      Background="{Binding Color.PitchCurveColor, Converter={StaticResource HexBrushConverter}}" />
              <ColorPicker x:Name="PitchCurveColorPicker"
                           IsAlphaEnabled="False" IsAlphaVisible="False"
                           Color="{Binding Color.PitchCurveColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="OtherTextColorRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBox x:Name="OtherTextColorBox" Width="110"
                       Text="{Binding Color.OtherTextColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
              <Border Width="20" Height="20" CornerRadius="3" VerticalAlignment="Center"
                      BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}"
                      Background="{Binding Color.OtherTextColor, Converter={StaticResource HexBrushConverter}}" />
              <ColorPicker x:Name="OtherTextColorPicker"
                           IsAlphaEnabled="False" IsAlphaVisible="False"
                           Color="{Binding Color.OtherTextColor, Mode=TwoWay, Converter={StaticResource HexColorConverter}}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="LyricPositionRow">
            <ComboBox x:Name="LyricPositionCombo" MinWidth="150"
                      ItemsSource="{Binding LyricPositionChoice.Options}"
                      SelectedItem="{Binding LyricPositionChoice.Selected, Mode=TwoWay}"
                      ItemTemplate="{StaticResource ChoiceTemplate}" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsSection>

      <!-- ===================== 字体 ===================== -->
      <controls:SettingsSection x:Name="FontSection">
        <StackPanel>
          <controls:SettingsRow x:Name="FontNoteRow">
            <ComboBox x:Name="FontNoteCombo" MinWidth="240"
                      ItemsSource="{Binding FontFamilies}"
                      SelectedItem="{Binding FontNote, Mode=TwoWay}"
                      SelectionChanged="OnFontSelectionChanged" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="FontUstLyricRow">
            <ComboBox x:Name="FontUstLyricCombo" MinWidth="240"
                      ItemsSource="{Binding FontFamilies}"
                      SelectedItem="{Binding FontUstLyric, Mode=TwoWay}"
                      SelectionChanged="OnFontSelectionChanged" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="FontLrcRow">
            <ComboBox x:Name="FontLrcCombo" MinWidth="240"
                      ItemsSource="{Binding FontFamilies}"
                      SelectedItem="{Binding FontLrc, Mode=TwoWay}"
                      SelectionChanged="OnFontSelectionChanged" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="FontOtherRow">
            <ComboBox x:Name="FontOtherCombo" MinWidth="240"
                      ItemsSource="{Binding FontFamilies}"
                      SelectedItem="{Binding FontOther, Mode=TwoWay}"
                      SelectionChanged="OnFontSelectionChanged" />
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsSection>

      <!-- ===================== 其他显示设置 ===================== -->
      <controls:SettingsSection x:Name="OtherSection">
        <StackPanel>
          <controls:SettingsRow x:Name="PitchPlaceholderRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ComboBox x:Name="PitchPlaceholderCombo" MinWidth="150"
                        ItemsSource="{Binding PitchPlaceholderChoice.Options}"
                        SelectedItem="{Binding PitchPlaceholderChoice.Selected, Mode=TwoWay}"
                        ItemTemplate="{StaticResource ChoiceTemplate}" />
              <TextBox x:Name="PitchCustomBox" MinWidth="150"
                       IsVisible="{Binding PitchPlaceholderChoice.IsCustom}"
                       Text="{Binding Player.PitchCustomText, Mode=TwoWay}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="SilentDisplayRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ComboBox x:Name="SilentDisplayCombo" MinWidth="150"
                        ItemsSource="{Binding SilentDisplayChoice.Options}"
                        SelectedItem="{Binding SilentDisplayChoice.Selected, Mode=TwoWay}"
                        ItemTemplate="{StaticResource ChoiceTemplate}" />
              <TextBox x:Name="SilentCustomBox" MinWidth="150"
                       IsVisible="{Binding SilentDisplayChoice.IsCustom}"
                       Text="{Binding Player.SilentCustomText, Mode=TwoWay}" />
            </StackPanel>
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="EndDisplayRow">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ComboBox x:Name="EndDisplayCombo" MinWidth="150"
                        ItemsSource="{Binding EndDisplayChoice.Options}"
                        SelectedItem="{Binding EndDisplayChoice.Selected, Mode=TwoWay}"
                        ItemTemplate="{StaticResource ChoiceTemplate}" />
              <TextBox x:Name="EndCustomBox" MinWidth="150"
                       IsVisible="{Binding EndDisplayChoice.IsCustom}"
                       Text="{Binding Player.EndCustomText, Mode=TwoWay}" />
            </StackPanel>
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsSection>

    </StackPanel>
  </ScrollViewer>

</UserControl>
