<Project Sdk="Microsoft.NET.Sdk">

  <!--
    测试工程：引用共享工程（业务逻辑 + ViewModels）。
    Phase 6 会补齐覆盖 1.1.x 全部 18 个测试域的用例。
  -->
  <PropertyGroup>
    <RootNamespace>UstPlayer.Tests</RootNamespace>
    <AssemblyName>ustPlayer.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- 需要 Avalonia 的 XAML 编译器（Avalonia.Headless 会注入，此处显式声明） -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- WriteableBitmap.Lock() 的帧缓冲拷贝需要指针（见 RenderBufferBlitTests） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />

    <!-- 无头 Avalonia：让主题接入 / XAML 解析能在无显示器环境（CI）被真实验证 -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <!--
    伴奏后端测试也要真的加载原生 libvlc，因此与桌面头一样引用原生包。
    只对有 NuGet 包的平台引用；Linux 用系统 libvlc。
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ustPlayer\ustPlayer.csproj" />
  </ItemGroup>

  <!--
    原生运行资源（渲染器）：由 build/sync-native-assets.ps1 同步进本目录，
    随构建输出到 renderer/ 供集成测试加载。实体不入库（见根 .gitignore）。

    同步动作挂在构建前：原生件是集成测试的**显式依赖**，不采用「缺失即静默跳过」，
    否则 CI 上渲染器一旦没就位，测试会一路绿灯而实际什么都没验证。
    脚本在找不到渲染器时会输出警告并以 0 退出（不阻断纯逻辑测试）。
  -->
  <ItemGroup>
    <None Include="renderer\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ffmpeg\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    翻译资产同样复制到测试输出目录：让「运行时能真的加载到语言目录」这件事
    可被测试覆盖（TranslationAssetsTests），而不是靠人工点击界面才发现语言设置失效。
  -->
  <ItemGroup>
    <None Include="..\pysourcecode\i18n\ustplayer_*.ts"
          Link="i18n\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 随程序分发的文本资源，同样复制过来以便测试能验证「部署」这一环 -->
  <ItemGroup>
    <None Include="..\ERcode.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Terms.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    增量：Inputs/Outputs 让本目标在已同步过之后直接跳过，避免每次增量构建都启动一个
    PowerShell 进程并对 2.8MB 的渲染器算两遍 SHA256。
    删除 renderer/<程序集名>.synced 即可强制重新同步。
  -->
  <Target Name="SyncNativeAssets"
          BeforeTargets="BeforeBuild"
          Condition="'$(OS)' == 'Windows_NT'"
          Inputs="$(MSBuildThisFileDirectory)..\build\sync-native-assets.ps1"
          Outputs="$(MSBuildThisFileDirectory)renderer\$(AssemblyName).synced">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\build\sync-native-assets.ps1&quot;"
          ContinueOnError="true"
          StandardOutputImportance="low"
          StandardErrorImportance="high" />
    <Touch Files="$(MSBuildThisFileDirectory)renderer\$(AssemblyName).synced"
           AlwaysCreate="true"
           Condition="Exists('$(MSBuildThisFileDirectory)renderer')" />
  </Target>

</Project>
