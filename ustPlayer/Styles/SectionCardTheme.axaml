<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:UstPlayer.Views.Controls">

  <!--
    SectionCard 的外观（移植自 1.1.x section_card.py 的 HeaderCardWidget 用法）。

    · 标题前的主题色竖线：颜色取 SystemAccentColor（Avalonia Fluent 主题定义的强调色资源，
      已在两个主题程序集中确认存在）。用 SolidColorBrush 包一层，因为该资源是 Color 而非 Brush。
    · 卡片底色用本仓库自定义的 CardBackgroundBrush（见 App.axaml 的主题字典）：
      亮色纯白实底、暗色半透明白，保证在窗口背景上清晰可辨。
    · 柔和投影让卡片从背景中"浮"出来（BoxShadow 语法：offsetX offsetY blur spread color）。
  -->
  <ControlTheme x:Key="{x:Type controls:SectionCard}" TargetType="controls:SectionCard">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 6 28 0 #1E000000"
                Margin="0,0,0,2">
          <StackPanel Margin="20,16,20,16" Spacing="12">
            <!-- 标题行：主题色竖线 + 分区名 -->
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Border Width="4" Height="18" CornerRadius="2" VerticalAlignment="Center">
                <Border.Background>
                  <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
                </Border.Background>
              </Border>
              <TextBlock Text="{TemplateBinding Title}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>

            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
