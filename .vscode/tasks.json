{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build uplr_converter",
            "type": "shell",
            "command": "cmd /c",
            "args": [
                "cd /d ${workspaceFolder}\\tools\\uplr_converter && build.bat"
