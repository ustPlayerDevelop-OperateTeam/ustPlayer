<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UstPlayer.ViewModels"
             xmlns:controls="using:UstPlayer.Views.Controls"
             x:Class="UstPlayer.Views.Pages.LyricPage"
             x:DataType="vm:LyricPageViewModel">

  <!--
    歌词页（对应 1.1.x lyric_page.py）：展示歌词开关 + LRC 文件选择。
    版式对齐 Windows 11 设置应用：分组标题在卡片外，每行「左标题 / 右控件」。
  -->
  <ScrollViewer>
    <StackPanel Margin="24,4,24,24">

      <controls:SettingsSection x:Name="LyricSection">
        <StackPanel>
          <controls:SettingsRow x:Name="ShowLyricRow">
            <ToggleSwitch IsChecked="{Binding Display.ShowLyric, Mode=TwoWay}" />
          </controls:SettingsRow>

          <controls:SettingsRow x:Name="LrcRow">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="LrcPathBox" MinWidth="320"
                       Text="{Binding Player.LrcPath, Mode=TwoWay}" />
              <Button x:Name="SelectLrcButton" Click="OnSelectLrcClick" />
            </StackPanel>
          </controls:SettingsRow>
        </StackPanel>
      </controls:SettingsSection>

    </StackPanel>
  </ScrollViewer>

</UserControl>
