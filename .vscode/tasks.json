{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build ustPlayer (dotnet)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}\\UstPlayer.slnx",
                "-c",
                "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "test ustPlayer (dotnet)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}\\UstPlayer.slnx",
                "--nologo"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "build uplr_converter (legacy 1.1.x)",
            "type": "shell",
            "command": "cmd /c",
            "args": [
                "cd /d ${workspaceFolder}\\pysourcecode\\tools\\uplr_converter && build.bat"
            ],
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
