<views:ShellWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="using:UstPlayer.Views"
                   x:Class="UstPlayer.Views.MainWindow"
                   Title="ustPlayer"
                   Width="900" Height="620"
                   WindowStartupLocation="CenterScreen">

  <!--
    窗口镶边：由 ShellWindow 基类设置（扩展客户区 + 保留系统窗口按钮），
    见 docs/adr-0002-window-chrome.md。内容可延伸进标题栏区域，
    因此顶部留出标题栏高度（-1 表示由平台自动计算）。

    ⚠️ 本页仍是**临时**内容：Phase 4 用它打通「选 UST → 全屏播放」这条端到端链路，
    Phase 5 会整体替换为 FluentAvalonia 的 NavigationView 外壳 + 5 个设置页。
    文案一律在 code-behind 里用 Translator.Tr(...) 设置（见 AGENTS.md 的 i18n 约定）。
  -->
  <StackPanel Margin="24,48,24,24" Spacing="12">
    <TextBlock Name="TitleText" FontSize="28" FontWeight="SemiBold" />
    <TextBlock Name="SubtitleText" Opacity="0.7" TextWrapping="Wrap" />
    <Button Name="OpenUstButton" Click="OnOpenUstClick" HorizontalAlignment="Left" />
    <TextBlock Name="StatusText" Opacity="0.7" TextWrapping="Wrap" />
    <TextBlock Name="ErrorText" Foreground="#C42B1C" TextWrapping="Wrap" IsVisible="False" />
  </StackPanel>

</views:ShellWindow>
