<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="using:UstPlayer.Views.Rendering"
        x:Class="UstPlayer.Views.PlayerWindow"
        Title="ustPlayer"
        Background="Black"
        WindowState="FullScreen"
        SystemDecorations="None"
        Topmost="True">

  <!--
    全屏播放器：画面由**播放器自己绘制**（版式见 Views/Rendering/PlayerCanvasRenderer.cs）。

    刻意不经过 uPlRender 渲染器：渲染器是为视频导出设计的，其版式与 1.1.x
    播放器的观感不一致（实测音名与歌字重叠、缺少播放器应有的布局）。
    播放器画面是播放器自己的职责，渲染器只留给导出。
  -->
  <rendering:PlayerCanvas Name="Canvas" />

</Window>
