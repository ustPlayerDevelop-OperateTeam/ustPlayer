<Project Sdk="Microsoft.NET.Sdk">

  <!--
    共享工程：全部业务逻辑 + 全部 UI（Views / ViewModels）。
    平台头（ustPlayer.Desktop / ustPlayer.Android）只负责启动，
    这样新增平台时无需改动本工程。

    Shift-JIS / GBK 代码页说明：.NET 10 已内置 CodePagesEncodingProvider，
    无需显式引用 System.Text.Encoding.CodePages（显式引用会触发 NU1510）。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>UstPlayer</RootNamespace>
    <!--
      程序集名取 ustPlayer.Core：与桌面头的 ustPlayer.exe 区分开。
      NuGet/MSBuild 要求同一解决方案内程序集名唯一，重名会报
      "Ambiguous project name"。
    -->
    <AssemblyName>ustPlayer.Core</AssemblyName>

    <!-- Avalonia 需要知道本工程含 XAML 资源 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      [LibraryImport] 源生成器与 up_render_to_buffer 的指针封送需要不安全代码
      （ClassIsland 同样开启该开关）。
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 共享工程要引用 Avalonia.Desktop（各平台头都复用同一套 UI） -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />

    <!-- Fluent v2 主题 + WinUI 控件（不要再叠加 FluentTheme/SimpleTheme） -->
    <PackageReference Include="FluentAvaloniaUI" />

    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!-- 测试工程需要访问内部类型（Interop / 时序等实现细节） -->
    <InternalsVisibleTo Include="ustPlayer.Tests" />
  </ItemGroup>

  <!--
    窗口/标题栏图标：把仓库根目录的图标**嵌入程序集**，而不是运行时按路径读文件。
    嵌入的好处与翻译资产正好相反——它不依赖打包时把文件放到某个目录，
    因此不会出现「图标在某些部署方式下悄悄消失」。

    两种格式各管一处（与 ClassIsland 的做法一致）：
      · `.ico` —— 窗口图标（任务栏 / Alt-Tab / 标题栏左侧），多尺寸，由系统按 DPI 选；
      · `.png` —— 标题栏里自己画的那个 18×18 小图标（Image 的 Source）。
    路径与 1.1.x 一致（两条产品线共用根目录的图标文件）。
  -->
  <ItemGroup>
    <AvaloniaResource Include="..\icon.ico" Link="Assets\icon.ico" />
    <AvaloniaResource Include="..\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

</Project>
