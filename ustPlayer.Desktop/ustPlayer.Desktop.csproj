<Project Sdk="Microsoft.NET.Sdk">

  <!--
    桌面平台头：Windows / macOS / Linux。
    只负责启动共享工程，不含业务逻辑。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>UstPlayer.Desktop</RootNamespace>
    <AssemblyName>ustPlayer</AssemblyName>
    <StartupObject>UstPlayer.Desktop.Program</StartupObject>

    <!--
      exe 图标：Windows 上任务栏 / 资源管理器 / 快捷方式显示的就是它（与 Window.Icon 各管一处）。
      图标是两条产品线共用的根目录资产（与 1.1.x 同一份文件）。
      只对 Windows 有意义，但设置它不影响其他平台的可构建性。
    -->
    <ApplicationIcon>..\icon.ico</ApplicationIcon>

    <!--
      发布目标：只列真正会发布且原生件齐备的目标。
      渲染器（uPlRender）与内置 FFmpeg 目前都没有 Windows/Linux arm64 产物，
      列出来只会让 restore 去解析用不上的 runtime pack。
      实际发布时仍由命令行 -r 指定。
    -->
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!--
    Windows 专属清单（DPI、supportedOS、UAC）。必须按平台条件化：
    无条件设置会把 Windows 清单塞进 macOS/Linux 产物，轻则告警重则构建失败。
    对照 ClassIsland 的做法（其 ApplicationManifest 只在 Platforms_Windows 为真时设置）。
  -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ustPlayer\ustPlayer.csproj" />
  </ItemGroup>

  <!--
    原生运行资源：随程序目录分发，运行时从 renderer\ 与 ffmpeg\ 子目录加载
    （沿用 1.1.x 的查找约定）。实体文件不入库（见根 .gitignore）。
    缺少时程序降级运行：视频导出不可用，播放器走纯可视化计时。
  -->
  <ItemGroup>
    <None Include="renderer\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ffmpeg\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    翻译资产：2.0 直接复用 1.1.x 的 .ts（见 I18n/Translator.cs 的说明），
    它们位于冻结产品线 pysourcecode/i18n/ 下。

    必须复制到程序目录的 i18n/ 子目录——Translator.LoadForLocale 只按
    程序目录查找（i18n/ → 程序根 → 用户数据目录），找不到任何目录时
    **语言设置会完全失效**（所有语言都显示中文），且不会有任何报错。
    Phase 6 打包时同样要把这些文件放进产物。
  -->
  <ItemGroup>
    <None Include="..\pysourcecode\i18n\ustplayer_*.ts"
          Link="i18n\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    设置页「ERcodes纠错」与「开源协议」按钮打开的是程序目录下的文本文件，
    因此必须把它们复制到输出目录（与 .ts 同样的道理：漏了不会报错，
    只是点了按钮永远失败）。两条产品线共用根目录的这两份文件。
  -->
  <ItemGroup>
    <None Include="..\ERcode.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Terms.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
