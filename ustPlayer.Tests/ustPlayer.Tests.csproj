<Project Sdk="Microsoft.NET.Sdk">

  <!--
    测试工程：引用共享工程（业务逻辑 + ViewModels）。
    Phase 6 会补齐覆盖 1.1.x 全部 18 个测试域的用例。
  -->
  <PropertyGroup>
    <RootNamespace>UstPlayer.Tests</RootNamespace>
    <AssemblyName>ustPlayer.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- 需要 Avalonia 的 XAML 编译器（Avalonia.Headless 会注入，此处显式声明） -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NetArchTest.Rules" />

    <!-- 无头 Avalonia：让主题接入 / XAML 解析能在无显示器环境（CI）被真实验证 -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ustPlayer\ustPlayer.csproj" />
  </ItemGroup>

</Project>
