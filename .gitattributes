# 自动检测文本文件并在仓库内规范为 LF
* text=auto

# ===================== 源码 =====================
*.cs        text diff=csharp
*.axaml     text
*.xaml      text
*.csproj    text
*.props     text
*.targets   text
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.py        text diff=python
*.cpp       text diff=cpp
*.h         text
*.c         text
*.rs        text diff=rust
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.sh        text eol=lf

# ===================== 配置 / 文档 / 翻译 =====================
*.yml       text
*.yaml      text
*.json      text
*.jsonc     text
*.md        text
*.toml      text
*.txt       text
*.ts        text
*.tsx       text

# ===================== 点文件 =====================
.gitignore    text
.gitattributes text
.editorconfig text

# ===================== 二进制（不做换行规范化） =====================
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.qm    binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.a     binary
*.lib   binary
*.pdb   binary
*.nupkg binary
