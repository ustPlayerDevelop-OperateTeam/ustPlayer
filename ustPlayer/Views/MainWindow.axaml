<views:ShellWindow xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:views="using:UstPlayer.Views"
                   xmlns:fa="using:FluentAvalonia.UI.Controls"
                   x:Class="UstPlayer.Views.MainWindow"
                   Title="ustPlayer"
                   Icon="/Assets/icon.ico"
                   Width="900" Height="620"
                   MinWidth="640" MinHeight="480"
                   WindowStartupLocation="CenterScreen">

  <!--
    窗口镶边：由 ShellWindow 基类设置（扩展客户区 + 保留系统窗口按钮），
    见 docs/adr-0002-window-chrome.md。

    因为客户区延伸进了标题栏，系统**不再绘制标题文字**，所以要自己画一行：
    图标 + 应用名（见下方 Row 0）。这一行同时充当拖拽区
    （TitleBarHitTestType=Complex 会把可交互控件排除在拖拽区之外）。

    导航项在 code-behind 里构造（标题需要 tr() 翻译，且页面实例要注入 ViewModel）。
  -->
  <Grid RowDefinitions="40,*">

    <!-- ===================== 标题栏（自绘） ===================== -->
    <!--
      两个元素都设 IsHitTestVisible=False：否则它们会参与命中测试，
      把标题栏这一段的拖拽区吃掉（ClassIsland 的标题栏元素同样如此）。
      标题文字绑定 Window.Title，不重复写一份字符串——
      改标题时只需要改一处。
    -->
    <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                Spacing="10"
                Margin="16,0,0,0"
                VerticalAlignment="Center">
      <Image Source="/Assets/icon.png"
             Width="18" Height="18"
             VerticalAlignment="Center"
             IsHitTestVisible="False"
             RenderOptions.BitmapInterpolationMode="HighQuality" />
      <TextBlock Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                 FontSize="12"
                 VerticalAlignment="Center"
                 IsHitTestVisible="False" />
    </StackPanel>

    <!--
      设置入口做成**自定义的 footer 菜单项**（见 code-behind 的 footer: true）：
      · 贴底：FooterMenuItems 就是导航栏的底部区域（更早的截图里「其他」即如此贴底）；
      · 外观一致：它与上面四项走完全相同的构造路径，样式必然相同。
      不用 NavigationView 内建的设置项（IsSettingsVisible），因为它的外观由模板决定、
      无法目视核对，而本仓库已经因为「看不到界面」在这一点上判断失误过。
    -->
    <fa:NavigationView x:Name="NavView" Grid.Row="1"
                       Margin="0,8,0,0"
                       IsSettingsVisible="False"
                       IsBackButtonVisible="False"
                       PaneDisplayMode="Left"
                       OpenPaneLength="200">
      <!--
        页面切换过渡：横向滑动 + 交叉淡入叠加（对应 ClassIsland 的
        CompositePageTransition：PageSlide + CrossFade，各 0.3 秒）。

        缓动取 ClassIsland 用的那组（cubic-bezier(0.76, 0, 0.24, 1)）在 Avalonia 里
        的等价写法 CubicEaseOut：两端慢、中间快，切换显得利落而不生硬。

        用 TransitioningContentControl 而不是把页面直接塞进 NavigationView.Content：
        后者是瞬间替换、没有过渡。页面实例仍由 code-behind 缓存（_pages），
        因此切换不会重建页面、输入到一半的内容不会丢。
      -->
      <TransitioningContentControl x:Name="PageHost">
        <TransitioningContentControl.PageTransition>
          <CompositePageTransition>
            <PageSlide Duration="0:0:0.3"
                       Orientation="Horizontal"
                       SlideOutEasing="CubicEaseOut"
                       SlideInEasing="CubicEaseOut" />
            <CrossFade Duration="0:0:0.3" />
          </CompositePageTransition>
        </TransitioningContentControl.PageTransition>
      </TransitioningContentControl>
    </fa:NavigationView>

    <!--
      通知浮层：右上角，**不参与布局**（所以不会把导航区挤下去），
      每条通知由 code-behind 加进来并做滑入动画，超时后自己移除。

      刻意不用放在正常布局里的 InfoBar（那是「内联提示条」的用法）：
      1.1.x 的提示是滑入 + 自动消失，FluentAvalonia 没有等价的静态弹出入口，
      因此这里用一个浮层 + 动画来实现。
      浮层按内容自适应大小，只覆盖右上角，不会挡住其余区域的点击。
    -->
    <Panel Grid.Row="0" Grid.RowSpan="2"
           Margin="0,46,12,0"
           VerticalAlignment="Top"
           HorizontalAlignment="Right">
      <StackPanel x:Name="NotificationStack" Spacing="8" Width="360" />
    </Panel>
  </Grid>

</views:ShellWindow>
